# Copy to .env (git-ignored). Leave blank to run open-baseline only.
# Single key for everything hosted (Jev + all frontier LLMs — OpenAI/Anthropic/Gemini
# models are all called via OpenRouter, not their own SDKs/keys). See DECISIONS.md 2026-09-22.
OPENROUTER_API_KEY=
HF_TOKEN=            # needed for GAIA (gated dataset) and Qwen3 weights
# OPENROUTER_API_BASE=https://openrouter.ai/api
# HTTPS_PROXY=       # only if compute nodes lack egress
