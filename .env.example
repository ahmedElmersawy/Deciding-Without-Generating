# Copy to .env (git-ignored). Leave blank to run open-baseline only.
# Single key for everything hosted (Jev + all frontier LLMs — OpenAI/Anthropic/Gemini
# models are all called via OpenRouter, not their own SDKs/keys).
OPENROUTER_API_KEY=
HF_TOKEN=            # needed for GAIA (gated dataset) and Qwen3 weights
# OPENROUTER_API_BASE=https://openrouter.ai/api
# HTTPS_PROXY=       # only if compute nodes lack egress
# Cluster only (read by scripts/env.sh, setup.sh and scripts/cacheguard_v2_submit.sh):
# DWG_SCRATCH=/path/to/large/disk   # conda env, HF cache, datasets; default ~/dwg-scratch
# SBATCH_ACCOUNT=                   # Slurm account; a bare `sbatch` needs it in your shell or -A
