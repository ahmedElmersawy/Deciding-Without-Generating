.env
results/*
!results/.gitkeep
# Benchmark states and replay runs are shared through git so collaborators (e.g. whoever runs
# the Gilbreth Kev jobs) can add to the same run. Logs stay local.
!results/states/
!results/replay/
# GAIA text must never be committed — the repo is public and GAIA's terms forbid crawlable
# re-sharing (CHECKS.md #5). Name any GAIA-derived states/runs with "gaia" in the path.
results/**/*gaia*
results/**/*GAIA*
cache/
.dwg_cache/
__pycache__/
*.pyc
*.egg-info/
.venv/
*.sif
